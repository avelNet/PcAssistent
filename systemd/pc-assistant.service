[Unit]
Description=PC Assistant — локальный AI-ассистент разработчика
Documentation=https://github.com/avelNet/PcAssistent
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=simple
# Пути подставляются install.sh автоматически.
# %h — домашняя директория пользователя (systemd specifier)
ExecStart=%h/Development/PcAssistent/.venv/bin/python3 %h/Development/PcAssistent/main.py
WorkingDirectory=%h/Development/PcAssistent
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
Environment=DISPLAY=:0
# %U — UID текущего пользователя (systemd specifier, заменяет хардкод 1000)
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
Environment=PULSE_SERVER=unix:/run/user/%U/pulse/native
Environment=PIPEWIRE_RUNTIME_DIR=/run/user/%U
ExecStartPre=/bin/sleep 5

[Install]
WantedBy=default.target
